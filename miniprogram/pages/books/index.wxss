.library-head{padding:22rpx 10rpx 30rpx}.library-head .hero-title{font-size:48rpx}.shelf{display:flex;flex-direction:column;gap:24rpx}.book{display:flex;padding:28rpx;border-radius:28rpx;background:#fff;border:1rpx solid #e7ebf1}.cover{position:relative;display:flex;flex-shrink:0;flex-direction:column;width:190rpx;height:264rpx;padding:30rpx 22rpx;border-radius:8rpx 18rpx 18rpx 8rpx;color:#fff;box-shadow:10rpx 14rpx 25rpx rgba(31,40,60,.2)}.cover-line{position:absolute;left:16rpx;top:0;width:2rpx;height:100%;background:rgba(255,255,255,.25)}.cover-name{margin-top:35rpx;text-align:center;font-family:serif;font-size:34rpx;font-weight:700;writing-mode:vertical-rl;align-self:center}.cover-en{margin-top:auto;text-align:center;font-size:14rpx;letter-spacing:2rpx;opacity:.75}.book-info{display:flex;min-width:0;flex:1;flex-direction:column;margin-left:30rpx}.book-title{font-size:34rpx;font-weight:750}.chapters{margin-top:8rpx;color:#1769ff;font-size:22rpx}.intro{display:-webkit-box;margin-top:18rpx;overflow:hidden;color:#7a8595;font-size:23rpx;line-height:1.6;-webkit-line-clamp:3;-webkit-box-orient:vertical}.read{margin-top:auto;color:#1769ff;font-weight:650}.gate{padding:80rpx 44rpx;text-align:center}.gate-icon{font-size:64rpx;color:#1769ff}.gate-title{margin-top:26rpx;font-size:34rpx;font-weight:750}.gate-desc{margin-top:18rpx;color:#7a8595;font-size:25rpx;line-height:1.7}.gate-btn{margin-top:38rpx}.gate-ghost{margin-top:20rpx}
