<view class="page">
  <view wx:if="{{checking}}" class="loading">正在确认查看权限…</view>
  <view wx:elif="{{!allowed}}" class="gate card">
    <view class="gate-icon">✉</view>
    <view class="gate-title">原创文字仅对已登记好友开放</view>
    <view class="gate-desc">此处收录的是开发者与好友的原创文字记录。请在“我的”页面输入联系人表中的姓名与手机号，关联身份后即可查看。</view>
    <button class="btn-primary gate-btn" bindtap="goVerify">去关联身份</button>
    <button wx:if="{{gateError}}" class="btn-ghost gate-ghost" bindtap="retryAccess">重新检测</button>
  </view>
  <block wx:else>
    <view class="library-head">
      <text class="eyebrow">好友原创</text>
      <view class="hero-title">原创文集</view>
      <view class="hero-desc">好友的原创文字记录，仅已登记好友可见。查看位置自动同步。</view>
    </view>
    <view class="shelf">
      <view class="book" wx:for="{{books}}" wx:key="key" data-key="{{item.key}}" bindtap="open">
        <view class="cover" style="background:{{item.color}}">
          <view class="cover-line"></view>
          <text class="cover-name">{{item.title}}</text>
          <text class="cover-en">原创文字</text>
        </view>
        <view class="book-info">
          <text class="book-title">{{item.title}}</text>
          <text class="chapters">{{item.chapters}} 篇<text wx:if="{{item.percentage}}"> · 已读 {{item.percentage}}%</text></text>
          <text class="intro">{{item.intro}}</text>
          <text class="read">{{item.readText || '进入查看 →'}}</text>
        </view>
      </view>
    </view>
  </block>
</view>
