<view class="page">
  <view class="library-head">
    <text class="eyebrow">WEMAIL LIBRARY</text>
    <view class="hero-title">私人书架</view>
    <view class="hero-desc">四部作品，五十三章故事。阅读位置会自动同步。</view>
  </view>
  <view class="shelf">
    <view class="book" wx:for="{{books}}" wx:key="key" data-key="{{item.key}}" bindtap="open">
      <view class="cover" style="background:{{item.color}}">
        <view class="cover-line"></view>
        <text class="cover-name">{{item.title}}</text>
        <text class="cover-en">WEMAIL NOVEL</text>
      </view>
      <view class="book-info">
        <text class="book-title">{{item.title}}</text>
        <text class="chapters">{{item.chapters}} 章<text wx:if="{{item.percentage}}"> · 已读 {{item.percentage}}%</text></text>
        <text class="intro">{{item.intro}}</text>
        <text class="read">{{item.readText || '开始阅读 →'}}</text>
      </view>
    </view>
  </view>
</view>
