<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取个人资料...</view>
  <view wx:elif="{{loadError}}" class="error-card card"><text class="error-title">个人资料获取失败</text><text selectable class="error-detail">{{loadError}}</text><button class="btn-ghost error-retry" bindtap="retryLoad">重新获取</button></view>
  <block wx:else>
    <view class="profile-card card">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar avatar-placeholder">{{profile.initial}}</view></button>
      <view class="profile-main"><input class="nickname" type="nickname" value="{{profile.nickname}}" placeholder="设置微信昵称" bindinput="nickname" bindblur="saveNickname" confirm-type="done" bindconfirm="saveNickname"/><text class="identity">{{profile.identityText}}</text></view>
      <text class="setting-link" bindtap="settings">设置</text>
    </view>
    <view class="stats-panel card">
      <view class="stat"><text class="number">{{stats.sent}}</text><text>寄出</text></view><view class="divider"></view>
      <view class="stat"><text class="number">{{stats.received}}</text><text>收到</text></view><view class="divider"></view>
      <view class="stat"><text class="number blue">{{stats.unsigned}}</text><text>待签收</text></view>
    </view>
    <view wx:if="{{!profile.contactId}}" class="bind-card">
      <view><text class="bind-title">关联你的信件资料</text><text class="bind-desc">输入联系人表中登记的姓名与手机号，核验通过后绑定微信账号</text></view>
      <view class="bind-form">
        <input class="bind-input" type="nickname" value="{{bindName}}" placeholder="姓名（需与联系人表一致）" bindinput="bindNameInput" confirm-type="next"/>
        <input class="bind-input" type="number" value="{{bindPhone}}" placeholder="手机号（11 位）" bindinput="bindPhoneInput" confirm-type="done"/>
      </view>
      <button class="phone-btn" bindtap="verifyIdentity" disabled="{{submitting}}">{{submitting ? '处理中…' : '验证并绑定'}}</button>
    </view>
    <view class="section">
      <view class="section-head"><text class="section-title">我的资料</text><text class="section-link" bindtap="settings">编辑资料</text></view>
      <view class="info-card card">
        <view class="info-row"><text class="info-label">联系人</text><text>{{profile.contactName || '未匹配'}}</text></view>
        <view class="info-row"><text class="info-label">手机号</text><text selectable>{{profile.contactPhone || profile.phoneNumber || '未绑定'}}</text></view>
        <view class="info-row"><text class="info-label">电子邮箱</text><text selectable class="info-value">{{profile.contactEmail || '未填写'}}</text></view>
        <view class="info-row"><text class="info-label">地址1</text><text class="info-value">{{profile.contactAddress1 || '未填写'}}</text></view>
        <view class="info-row"><text class="info-label">邮编1</text><text class="info-value">{{profile.contactPostcode1 || '未填写'}}</text></view>
        <view class="info-row"><text class="info-label">地址2</text><text class="info-value">{{profile.contactAddress2 || '未填写'}}</text></view>
        <view class="info-row"><text class="info-label">邮编2</text><text class="info-value">{{profile.contactPostcode2 || '未填写'}}</text></view>
        <view class="info-row"><text class="info-label">QQ</text><text selectable class="info-value">{{profile.contactQq || '未填写'}}</text></view>
      </view>
    </view>
    <view class="section quick"><button class="btn-primary" bindtap="compose">登记寄件</button></view>
    <view class="privacy">仅联系人表中已登记的用户可访问；资料仅用于寄件记录、抽奖与报名身份匹配</view>
  </block>
</view>
