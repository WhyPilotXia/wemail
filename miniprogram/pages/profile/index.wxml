<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取个人资料...</view>
  <view wx:elif="{{loadError}}" class="error-card card"><text class="error-title">个人资料获取失败</text><text selectable class="error-detail">{{loadError}}</text><button class="btn-ghost error-retry" bindtap="retryLoad">重新获取</button></view>
  <block wx:else>
    <view class="profile-card card">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar"><image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill"/><view wx:else class="avatar avatar-placeholder">{{profile.initial}}</view></button>
      <view class="profile-main"><input class="nickname" type="nickname" value="{{profile.nickname}}" placeholder="设置微信昵称" bindinput="nickname" bindblur="saveNickname" confirm-type="done" bindconfirm="saveNickname"/><text class="identity">{{profile.identityText}}</text></view>
      <text class="setting-link" bindtap="settings">设置</text>
    </view>
    <view class="stats-panel card">
      <view class="stat"><text class="number">{{stats.sent}}</text><text>寄出</text></view><view class="divider"></view>
      <view class="stat"><text class="number">{{stats.received}}</text><text>收到</text></view><view class="divider"></view>
      <view class="stat"><text class="number blue">{{stats.unsigned}}</text><text>待签收</text></view>
    </view>
    <view wx:if="{{!profile.phoneNumber}}" class="bind-card">
      <view><text class="bind-title">关联你的信件资料</text><text class="bind-desc">授权手机号后，将自动匹配 Notion 联系人及地址</text></view>
      <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="getPhone">手机号快捷登录</button>
    </view>
    <view class="section">
      <view class="section-head"><text class="section-title">我的资料</text></view>
      <view class="info-card card">
        <view class="info-row"><text class="info-label">联系人</text><text>{{profile.contactName || '未匹配'}}</text></view>
        <view class="info-row"><text class="info-label">手机号</text><text selectable>{{profile.phoneNumber || '未绑定'}}</text></view>
        <view class="info-row"><text class="info-label">地址</text><text class="info-value">{{profile.address || '匹配联系人后自动显示'}}</text></view>
      </view>
    </view>
    <view class="section quick"><button class="btn-primary" bindtap="compose">寄一封信</button></view>
    <view class="privacy">资料仅用于信件、抽奖与报名身份匹配</view>
  </block>
</view>
