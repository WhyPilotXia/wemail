.profile-card{display:flex;align-items:center;padding:30rpx}.avatar-button{width:104rpx;height:104rpx;padding:0;border-radius:50%;background:transparent}.avatar{display:flex;align-items:center;justify-content:center;width:104rpx;height:104rpx;border-radius:50%}.avatar-placeholder{background:linear-gradient(135deg,#1769ff,#8257e6);color:#fff;font-size:40rpx;font-weight:700}.profile-main{flex:1;min-width:0;margin-left:24rpx}.nickname{height:48rpx;font-size:34rpx;font-weight:750}.identity{display:block;margin-top:8rpx;color:#8490a2;font-size:23rpx}.setting-link{color:#1769ff;font-size:24rpx}.stats-panel{display:flex;align-items:center;margin-top:20rpx;padding:28rpx 10rpx}.stat{flex:1;text-align:center;color:#7d8797;font-size:22rpx}.number{display:block;color:#172033;font-size:42rpx;font-weight:800}.number.blue{color:#1769ff}.divider{width:1rpx;height:58rpx;background:#e7ebf2}.bind-card{margin-top:20rpx;padding:30rpx;border-radius:28rpx;background:linear-gradient(130deg,#1769ff,#4a86f7);color:#fff}.bind-title{display:block;font-size:30rpx;font-weight:750}.bind-desc{display:block;margin-top:10rpx;color:#d9e6ff;font-size:23rpx;line-height:1.55}.bind-form{margin-top:24rpx}.bind-input{height:78rpx;margin-bottom:20rpx;padding:0 24rpx;border-radius:16rpx;background:rgba(255,255,255,.18);color:#fff;font-size:28rpx}.bind-input::placeholder{color:rgba(255,255,255,.65)}.phone-btn{height:78rpx;margin-top:8rpx;background:#fff;color:#1769ff;font-weight:650}.phone-btn[disabled]{opacity:.7;color:#8490a2}.info-card{padding:0 28rpx}.info-row{display:flex;padding:26rpx 0;border-bottom:1rpx solid #edf0f4}.info-row:last-child{border:0}.info-label{width:150rpx;color:#7d8797}.info-value{flex:1;text-align:right;line-height:1.5}.quick{padding-bottom:10rpx}.privacy{text-align:center;color:#a2aab6;font-size:21rpx}
