page{background:#f7f1e7}.reader{min-height:100vh;padding:38rpx 42rpx 100rpx;color:#2c2924}.reader-top{display:flex;align-items:center;justify-content:space-between;padding-bottom:34rpx;border-bottom:1rpx solid rgba(85,72,56,.13)}.book-label{color:#8d7559;font-size:23rpx}.tools{display:flex;gap:30rpx;color:#705c45;font-size:24rpx}.chapter-no{margin-top:70rpx;text-align:center;color:#9b8264;font-size:19rpx;letter-spacing:4rpx}.chapter-title{margin-top:20rpx;text-align:center;font-family:serif;font-size:44rpx;font-weight:700}.ornament{margin:26rpx 0 48rpx;text-align:center;color:#ad9579;letter-spacing:15rpx}.content{font-family:"Songti SC",serif;line-height:2.05;text-align:justify}.content-text{white-space:pre-wrap}.content-image{display:block;width:100%;height:auto;margin:30rpx auto;border-radius:12rpx}.pager{display:flex;align-items:center;justify-content:space-between;margin-top:80rpx;padding-top:34rpx;border-top:1rpx solid rgba(85,72,56,.13);color:#8c765c;font-size:23rpx}.pager button{width:180rpx;height:68rpx;background:#eee5d8;color:#5e4e3b}.mask{position:fixed;inset:0;background:rgba(20,25,32,.4);z-index:9}.catalog{position:fixed;left:0;bottom:-75vh;width:100%;height:72vh;border-radius:32rpx 32rpx 0 0;background:#fff;z-index:10;transition:bottom .25s}.catalog.show{bottom:0}.catalog-head{display:flex;justify-content:space-between;padding:32rpx;font-weight:700;border-bottom:1rpx solid #eceef2}.catalog-list{height:calc(72vh - 100rpx)}.catalog-item{display:flex;justify-content:space-between;padding:28rpx 34rpx;border-bottom:1rpx solid #f0f1f4}.catalog-item.active{color:#1769ff;background:#f4f7ff}.gate-status{padding:120rpx 0;text-align:center;color:#8d7559;font-size:26rpx}.gate-block{margin-top:180rpx;text-align:center;color:#2c2924}.gate-block .gate-icon{font-size:64rpx;color:#b0402f}.gate-block .gate-title{margin-top:26rpx;font-size:34rpx;font-weight:750}.gate-block .gate-desc{margin:18rpx 60rpx 0;color:#705c45;font-size:25rpx;line-height:1.7}.gate-block .gate-btn{width:320rpx;height:80rpx;margin-top:38rpx;background:#5e4e3b;color:#fff;font-weight:650}.gate-block .gate-btn.ghost{background:transparent;color:#5e4e3b;border:1rpx solid rgba(85,72,56,.3);margin-top:20rpx}