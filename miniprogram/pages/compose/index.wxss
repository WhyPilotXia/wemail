.compose-head{padding:18rpx 12rpx}.compose-head .hero-title{font-size:46rpx}.picker-value{display:flex;justify-content:space-between;gap:20rpx;font-size:29rpx}.picker-value text:first-child{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.placeholder{color:#9aa4b3}.contact-card{display:flex;flex-direction:column;margin-top:22rpx;padding:28rpx;border-radius:24rpx;color:#23324b}.sender-card{background:#f5f7fb}.recipient-card{background:#edf4ff}.contact-label{color:#1769ff;font-size:22rpx}.contact-name{margin-top:10rpx;font-weight:700}.contact-line{margin-top:8rpx;color:#66758a;font-size:24rpx;line-height:1.55;word-break:break-all}.contact-warning{margin-top:12rpx;color:#c63f3f;font-size:23rpx}.submit{margin-top:32rpx}.postage-entry{display:flex;align-items:center;margin-top:22rpx;padding:28rpx}.postage-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:22rpx;background:#edf4ff;color:#1769ff;font-size:34rpx;font-weight:800}.postage-copy{display:flex;flex:1;flex-direction:column;margin-left:22rpx}.postage-title{font-size:29rpx;font-weight:750}.postage-desc{margin-top:8rpx;color:#7a8495;font-size:22rpx}.postage-arrow{color:#1769ff;font-size:40rpx}.tip{margin-top:18rpx;text-align:center;color:#9ca5b2;font-size:21rpx}
.tracking-row{gap:20rpx}
.tracking-input{flex:1;min-width:0}
.scan-btn{display:flex;align-items:center;gap:10rpx;padding:10rpx 18rpx;border-radius:18rpx;background:#edf4ff}
.scan-btn-hover{background:#dde9ff}
.scan-frame{position:relative;width:40rpx;height:40rpx;flex-shrink:0}
.scan-corner{position:absolute;width:12rpx;height:12rpx;border-color:#1769ff;border-style:solid;border-width:0}
.scan-corner.a{left:0;top:0;border-left-width:3rpx;border-top-width:3rpx;border-top-left-radius:6rpx}
.scan-corner.b{right:0;top:0;border-right-width:3rpx;border-top-width:3rpx;border-top-right-radius:6rpx}
.scan-corner.c{left:0;bottom:0;border-left-width:3rpx;border-bottom-width:3rpx;border-bottom-left-radius:6rpx}
.scan-corner.d{right:0;bottom:0;border-right-width:3rpx;border-bottom-width:3rpx;border-bottom-right-radius:6rpx}
.scan-line{position:absolute;left:8rpx;right:8rpx;top:50%;height:3rpx;margin-top:-1.5rpx;border-radius:99rpx;background:#1769ff}
.scan-text{color:#1769ff;font-size:24rpx;font-weight:600}
