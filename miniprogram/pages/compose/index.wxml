<view class="page">
  <view class="compose-head"><text class="eyebrow">NEW LETTER</text><view class="hero-title">寄一封信</view><view class="hero-desc">每一封被认真记录的信，都值得被等待。</view></view>
  <view class="form-card card section">
    <view class="field"><text class="label">寄件人</text><picker range="{{contacts}}" range-key="name" value="{{senderIndex}}" bindchange="selectSender"><view class="picker-value {{senderIndex<0?'placeholder':''}}">{{senderIndex>=0?contacts[senderIndex].name:'请选择寄件人'}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">收件人</text><picker range="{{contacts}}" range-key="name" value="{{recipientIndex}}" bindchange="selectRecipient"><view class="picker-value {{recipientIndex<0?'placeholder':''}}">{{recipientIndex>=0?contacts[recipientIndex].name:'请选择收件人'}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">寄出日期</text><picker mode="date" value="{{form.sendDate}}" bindchange="changeDate"><view class="picker-value">{{form.sendDate}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">信件类型</text><picker range="{{mailTypes}}" bindchange="changeType"><view class="picker-value">{{form.mailType}} <text>›</text></view></picker></view>
    <view class="field"><text class="label">邮件编号（选填）</text><input class="input" placeholder="挂号信或包裹的查询编号" value="{{form.trackingNo}}" data-key="trackingNo" bindinput="input"/></view>
    <view class="field"><text class="label">备注（选填）</text><input class="input" placeholder="例如：生日贺卡" value="{{form.title}}" data-key="title" bindinput="input"/></view>
  </view>
  <view wx:if="{{recipientIndex>=0}}" class="address-card"><text class="address-label">寄送至</text><text class="address-name">{{contacts[recipientIndex].name}}</text><text class="address-text">{{contacts[recipientIndex].postcode1}} {{contacts[recipientIndex].address1 || '未填写地址'}}</text></view>
  <button class="btn-primary submit" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">记录寄出</button>
  <view class="tip">此处记录寄信信息，不包含线上邮寄或付费服务</view>
</view>
