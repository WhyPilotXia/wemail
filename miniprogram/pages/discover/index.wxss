.discover-hero{background:linear-gradient(145deg,#fff 0%,#f3efff 100%);border-color:#e6ddff}.feature{position:relative;min-height:310rpx;padding:38rpx;border-radius:30rpx;overflow:hidden;background:linear-gradient(130deg,#14213d,#273b66);color:#fff}.feature-copy{position:relative;z-index:2;display:flex;flex-direction:column;width:58%}.feature-label{color:#a9c4ff;font-size:22rpx}.feature-title{margin-top:12rpx;font-size:48rpx;font-weight:800}.feature-desc{margin-top:14rpx;color:#c9d3e9;font-size:24rpx;line-height:1.6}.feature-action{margin-top:34rpx;color:#fff;font-weight:650}.book-art{position:absolute;right:24rpx;bottom:8rpx;width:230rpx;height:270rpx}.book-cover{position:absolute;width:120rpx;height:196rpx;padding:18rpx;border-radius:8rpx;box-shadow:0 15rpx 30rpx rgba(0,0,0,.35);font-size:38rpx;font-weight:800}.book-cover.one{right:8rpx;top:18rpx;background:#dd5b45;transform:rotate(7deg)}.book-cover.two{right:75rpx;top:42rpx;background:#2c806f;transform:rotate(-7deg)}.book-cover.three{right:46rpx;top:70rpx;background:#c69435}.event-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.event-card{display:flex;flex-direction:column;min-height:310rpx;padding:28rpx;border-radius:28rpx;border:1rpx solid #e5eaf1}.event-card.lottery{background:linear-gradient(145deg,#fff7e9,#fff)}.event-card.signup{background:linear-gradient(145deg,#ecf4ff,#fff)}.event-icon{display:flex;align-items:center;justify-content:center;width:72rpx;height:72rpx;border-radius:22rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(46,60,88,.09);font-weight:800}.event-title{margin-top:25rpx;font-size:30rpx;font-weight:750}.event-desc{margin-top:10rpx;color:#7a8495;font-size:23rpx;line-height:1.55}.event-link{margin-top:auto;color:#1769ff;font-size:23rpx;font-weight:600}.quote{display:flex;flex-direction:column;margin-top:34rpx;padding:34rpx}.quote-mark{color:#1769ff;font-family:serif;font-size:64rpx;line-height:.6}.quote-text{font-family:serif;font-size:28rpx;line-height:1.8}.quote-from{margin-top:16rpx;color:#98a1af;font-size:22rpx}
