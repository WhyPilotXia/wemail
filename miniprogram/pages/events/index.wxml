<view class="page"><view class="tabs"><view class="tab {{tab==='lottery'?'active':''}}" data-tab="lottery" bindtap="changeTab">幸运抽奖</view><view class="tab {{tab==='signup'?'active':''}}" data-tab="signup" bindtap="changeTab">限额报名</view></view><view class="event-hero"><view><text class="eyebrow">{{tab==='lottery'?'LUCKY DRAW':'SIGN UP'}}</text><view class="event-hero-title">{{tab==='lottery'?'等待好运揭晓':'为喜欢的事留个位置'}}</view></view><button class="new-btn" bindtap="toggleForm">{{showForm?'取消':'发起'}}</button></view><view wx:if="{{showForm}}" class="form-card card"><view class="field"><text class="label">标题</text><input class="input" data-key="title" value="{{form.title}}" bindinput="input" placeholder="活动名称"/></view><view class="field"><text class="label">说明</text><textarea class="textarea small" data-key="description" value="{{form.description}}" bindinput="input" placeholder="介绍奖品或报名内容"/></view><view class="field"><text class="label">截止日期</text><picker mode="date" bindchange="changeDate"><view>{{form.deadline}} ›</view></picker></view><view class="field" wx:if="{{tab==='signup'}}"><text class="label">报名上限</text><input class="input" type="number" data-key="limit" value="{{form.limit}}" bindinput="input" placeholder="留空表示不限"/></view><view class="field row space"><text>允许参与者备注</text><switch checked="{{form.allowNote}}" bindchange="switchNote" color="#1769ff"/></view><button class="btn-primary" bindtap="create">确认发起</button></view><view class="section"><view wx:if="{{loading}}" class="loading">加载活动中...</view><view wx:elif="{{!events.length}}" class="card empty">暂无进行中的{{tab==='lottery'?'抽奖':'报名'}}</view><view class="activity card" wx:for="{{events}}" wx:key="_id"><view class="activity-top"><text class="tag">{{tab==='lottery'?'抽奖':'报名'}}</text><text class="state">{{item.statusText}}</text></view><text class="activity-title">{{item.title}}</text><text class="activity-desc">{{item.description||'发起人暂未填写说明'}}</text><view class="activity-info"><text>截止 {{item.deadlineText}}</text><text>{{item.participantCount}}{{item.limit?' / '+item.limit:''}} 人</text></view><view wx:if="{{item.winnerName}}" class="winner">获奖者：{{item.winnerName}}</view><view class="activity-actions" wx:if="{{item.status==='open'}}"><button class="join" data-id="{{item._id}}" bindtap="join">{{item.joined?'已参与':'立即参与'}}</button><button wx:if="{{item.isOwner && tab==='lottery'}}" class="draw" data-id="{{item._id}}" bindtap="draw">立即开奖</button></view></view></view></view>
