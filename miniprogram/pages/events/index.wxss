.tabs{display:flex;padding:7rpx;border-radius:20rpx;background:#e9edf4}.tab{flex:1;padding:20rpx;text-align:center;border-radius:16rpx;color:#6f7b8d}.tab.active{background:#fff;color:#1769ff;box-shadow:0 5rpx 18rpx rgba(43,61,94,.1);font-weight:700}.event-hero{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;padding:34rpx;border-radius:28rpx;background:#fff}.event-hero-title{margin-top:10rpx;font-size:34rpx;font-weight:750}.new-btn{width:120rpx;height:66rpx;background:#1769ff;color:#fff}.form-card{margin-top:20rpx;padding-bottom:28rpx}.textarea.small{min-height:120rpx}.activity{padding:28rpx;margin-bottom:18rpx}.activity-top,.activity-info,.activity-actions{display:flex;align-items:center;justify-content:space-between}.state{color:#8b95a5;font-size:22rpx}.activity-title{display:block;margin-top:22rpx;font-size:32rpx;font-weight:750}.activity-desc{display:block;margin-top:10rpx;color:#778294;font-size:24rpx;line-height:1.6}.activity-info{margin-top:26rpx;padding-top:22rpx;border-top:1rpx solid #edf0f4;color:#8390a1;font-size:22rpx}.winner{margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#fff5db;color:#9a6200}.activity-actions{gap:14rpx;margin-top:20rpx}.join,.draw{flex:1;height:70rpx}.join{background:#1769ff;color:#fff}.draw{border:1rpx solid #1769ff;background:#fff;color:#1769ff}
