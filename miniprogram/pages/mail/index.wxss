.hero-actions{display:flex;gap:18rpx;margin-top:30rpx;position:relative;z-index:1}.hero-btn{width:230rpx}.contact-btn{width:150rpx;height:88rpx;background:#fff;color:#1769ff;border:1rpx solid #cfe0ff}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin-top:22rpx}.stat{padding:26rpx 12rpx;text-align:center}.stat-value{display:block;font-size:44rpx;font-weight:800}.stat-value.accent{color:#1769ff}.stat-label{display:block;margin-top:5rpx;color:#788498;font-size:21rpx}.filters{white-space:nowrap;margin-bottom:20rpx}.filter{display:inline-flex;align-items:center;height:62rpx;padding:0 27rpx;margin-right:12rpx;border-radius:99rpx;background:#fff;color:#667085;border:1rpx solid #e5eaf1;font-size:24rpx}.filter.active{background:#1769ff;color:#fff;border-color:#1769ff}.mail-item{padding:28rpx;margin-bottom:18rpx}.mail-top,.mail-bottom{display:flex;align-items:center;justify-content:space-between}.mail-type{font-weight:700}.mail-date{margin-left:16rpx;color:#8a94a5;font-size:23rpx}.status{padding:8rpx 16rpx;border-radius:99rpx;font-size:21rpx}.status.done{color:#16845b;background:#e9f8f1}.status.pending{color:#ad6500;background:#fff5df}.mail-route{display:flex;align-items:center;margin:30rpx 0}.person{width:42%;display:flex;flex-direction:column;color:#8791a2;font-size:22rpx}.person.right{text-align:right}.person-name{margin-bottom:5rpx;color:#172033;font-size:28rpx;font-weight:650}.route-line{width:16%;text-align:center;color:#1769ff;font-size:34rpx}.mail-bottom{padding-top:22rpx;border-top:1rpx solid #edf0f4}.tracking{color:#7b8799;font-size:22rpx}.sign-btn{height:56rpx;padding:0 20rpx;background:#1769ff;color:#fff;font-size:22rpx}.empty-icon{font-size:58rpx;color:#1769ff}.empty-sub{margin-top:8rpx;font-size:23rpx;color:#a0a8b5}
