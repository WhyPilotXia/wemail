.search{display:flex;align-items:center;min-height:86rpx;padding:0 26rpx;color:#728096}.search input{flex:1;margin-left:16rpx}.count{padding:24rpx 8rpx;color:#8a94a3;font-size:23rpx}.contact{padding:25rpx;margin-bottom:16rpx}.contact-head{display:flex;align-items:center}.avatar{display:flex;align-items:center;justify-content:center;width:78rpx;height:78rpx;border-radius:24rpx;background:#eaf2ff;color:#1769ff;font-weight:750}.title{display:flex;flex:1;align-items:center;min-width:0;margin-left:22rpx}.name{font-weight:700}.me{margin-left:12rpx;padding:3rpx 12rpx;border-radius:99rpx;background:#eaf2ff;color:#1769ff;font-size:19rpx}.copy{height:54rpx;padding:0 17rpx;background:#f0f5ff;color:#1769ff;font-size:21rpx}.detail{margin-top:20rpx;padding-top:14rpx;border-top:1rpx solid #edf0f5}.data-row{display:flex;align-items:flex-start;padding:7rpx 0;font-size:23rpx;line-height:1.55}.data-label{flex:0 0 76rpx;color:#8a94a3}.data-value{flex:1;min-width:0;color:#3f4b5e;word-break:break-all}
