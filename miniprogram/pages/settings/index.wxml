<view class="page">
  <view class="hero">
    <text class="eyebrow">PROFILE</text>
    <view class="hero-title">个人设置</view>
    <view class="hero-desc">姓名与联系人身份由管理员在联系人表中维护，其余资料修改后将同步至 Notion 联系人表。</view>
  </view>

  <view class="form-card card section">
    <view class="field"><text class="label">联系人（不可修改）</text><input class="input muted-input" value="{{contact.name}}" disabled placeholder="关联身份后显示"/></view>
    <view class="field"><text class="label">昵称</text><input class="input" value="{{profile.nickname}}" data-key="nickname" bindinput="input" placeholder="你的称呼"/></view>
    <view class="field"><text class="label">手机号</text><input class="input" type="number" value="{{fields.phone}}" data-key="phone" bindinput="input" placeholder="联系人表中登记的手机号"/></view>
    <view class="field"><text class="label">电子邮箱</text><input class="input" value="{{fields.email}}" data-key="email" bindinput="input" placeholder="example@mail.com"/></view>
    <view class="field"><text class="label">QQ</text><input class="input" value="{{fields.qq}}" data-key="qq" bindinput="input" placeholder="QQ 号"/></view>
    <view class="field"><text class="label">地址1</text><textarea class="textarea" value="{{fields.address1}}" data-key="address1" bindinput="input" placeholder="省、市、区及详细地址"/></view>
    <view class="field"><text class="label">邮编1</text><input class="input" value="{{fields.postcode1}}" data-key="postcode1" bindinput="input" placeholder="邮政编码"/></view>
    <view class="field"><text class="label">地址2</text><textarea class="textarea" value="{{fields.address2}}" data-key="address2" bindinput="input" placeholder="备用地址（可留空）"/></view>
    <view class="field"><text class="label">邮编2</text><input class="input" value="{{fields.postcode2}}" data-key="postcode2" bindinput="input" placeholder="备用地址邮政编码"/></view>
  </view>
  <view wx:if="{{!profile.contactId}}" class="bind-tip section">尚未关联身份，请先返回“我的”页面完成姓名手机号核验，再修改联系人资料。</view>
  <button class="btn-primary section" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存资料'}}</button>

  <view class="udp-card card">
    <view class="udp-head">
      <view class="status-dot status-{{udpStatus}}"></view>
      <view class="udp-main"><text class="udp-title">UDP 测试</text><text class="udp-address">{{udpHost}}:{{udpPort}}</text></view>
      <button class="udp-button" loading="{{testing}}" disabled="{{testing}}" bindtap="testUdp">{{testing ? '测试中' : '开始测试'}}</button>
    </view>
    <text class="udp-result">{{udpStatusText}}</text>
    <text wx:if="{{udpDetail}}" selectable class="udp-detail">{{udpDetail}}</text>
  </view>
</view>
