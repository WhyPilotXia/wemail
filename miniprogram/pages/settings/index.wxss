.udp-card{margin-top:25rpx;padding:28rpx}.udp-head{display:flex;align-items:center}.status-dot{width:22rpx;height:22rpx;border-radius:50%;background:#a2aab6;box-shadow:0 0 0 9rpx #f0f2f6}.status-testing{background:#f59e0b;box-shadow:0 0 0 9rpx #fff3d6}.status-success{background:#16a36a;box-shadow:0 0 0 9rpx #dff7ec}.status-failed{background:#e5484d;box-shadow:0 0 0 9rpx #ffe5e6}.udp-main{flex:1;margin-left:24rpx}.udp-title{display:block;color:#172033;font-size:29rpx;font-weight:750}.udp-address{display:block;margin-top:5rpx;color:#8490a2;font-size:22rpx}.udp-button{width:154rpx;height:66rpx;border:1rpx solid #cbd8ee;background:#fff;color:#1769ff;font-size:23rpx;font-weight:650}.udp-result{display:block;margin-top:24rpx;color:#344054;font-size:24rpx;font-weight:650}.udp-detail{display:block;margin-top:8rpx;color:#7d8797;font-size:21rpx;line-height:1.55;word-break:break-all}
