page { background: #f6f8fc; color: #111827; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; font-size: 28rpx; }
view, text, image, input, textarea, button, scroll-view { box-sizing: border-box; }
button { display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border-radius: 20rpx; font-size: 28rpx; line-height: 1; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.hero { position: relative; overflow: hidden; padding: 40rpx; border: 1rpx solid #dce6f8; border-radius: 32rpx; background: linear-gradient(135deg,#ffffff 10%,#edf4ff 100%); box-shadow: 0 12rpx 35rpx rgba(31,65,116,.08); }
.hero::after { content: ""; position: absolute; width: 220rpx; height: 220rpx; right: -65rpx; top: -80rpx; border-radius: 50%; background: rgba(23,105,255,.08); }
.eyebrow { color: #1769ff; font-size: 24rpx; font-weight: 600; }
.hero-title { margin-top: 12rpx; font-size: 50rpx; line-height: 1.15; font-weight: 800; letter-spacing: -1rpx; }
.hero-desc { margin-top: 16rpx; color: #64748b; font-size: 26rpx; line-height: 1.65; }
.section { margin-top: 34rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-title { font-size: 34rpx; font-weight: 750; }
.section-link { color: #1769ff; font-size: 25rpx; }
.card { background: #fff; border: 1rpx solid #e6ebf3; border-radius: 28rpx; box-shadow: 0 8rpx 28rpx rgba(31,50,81,.06); }
.btn-primary { display: flex; align-items: center; justify-content: center; height: 88rpx; background: #1769ff; color: #fff; font-weight: 650; }
.btn-ghost { display: flex; align-items: center; justify-content: center; height: 82rpx; border: 1rpx solid #dce4f0; background: #fff; color: #334155; }
.tag { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 18rpx; border-radius: 99rpx; background: #edf4ff; color: #1769ff; font-size: 22rpx; }
.muted { color: #7b8799; }
.empty { padding: 70rpx 28rpx; text-align: center; color: #8a95a5; }
.loading { padding: 80rpx; text-align: center; color: #64748b; }
.error-card { padding: 32rpx; border-color: #fecaca; background: #fffafa; }
.error-title { display: block; color: #b42318; font-size: 30rpx; font-weight: 700; }
.error-detail { display: block; margin-top: 14rpx; color: #7a271a; font-size: 23rpx; line-height: 1.65; word-break: break-all; white-space: pre-wrap; }
.error-retry { width: 220rpx; margin-top: 24rpx; color: #b42318; border-color: #fecaca; }
.form-card { padding: 10rpx 30rpx; }
.field { padding: 26rpx 0; border-bottom: 1rpx solid #edf0f5; }
.field:last-child { border-bottom: 0; }
.label { display: block; margin-bottom: 12rpx; color: #677386; font-size: 24rpx; }
.input { width: 100%; height: 56rpx; color: #111827; font-size: 29rpx; }
.textarea { width: 100%; min-height: 180rpx; line-height: 1.7; }
.row { display: flex; align-items: center; }
.space { justify-content: space-between; }
