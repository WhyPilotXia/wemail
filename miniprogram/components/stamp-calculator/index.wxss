.postage-card{padding:28rpx}.postage-head{display:flex;align-items:flex-start;justify-content:space-between;padding-bottom:12rpx}.postage-title{display:block;font-size:32rpx;font-weight:750}.postage-subtitle{display:block;margin-top:7rpx;color:#8490a2;font-size:22rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #edf0f5}.label{display:block;margin-bottom:11rpx;color:#677386;font-size:23rpx}.input{width:100%;height:54rpx;font-size:28rpx}.denom-title{margin-top:24rpx;color:#677386;font-size:23rpx}.denom-grid{display:flex;flex-wrap:nowrap;justify-content:space-between;gap:10rpx;margin-top:16rpx}.denom-chip{flex:1;padding:12rpx 0;border-radius:99rpx;border:1rpx solid #dfe5ee;background:#fff;color:#677386;font-size:24rpx;text-align:center;white-space:nowrap}.denom-chip.on{border-color:#1769ff;background:#edf4ff;color:#1769ff;font-weight:650}.result-card{display:flex;flex-direction:column;margin-top:24rpx;padding:26rpx;border-radius:22rpx;background:linear-gradient(135deg,#edf4ff,#f8fbff)}.result-label{color:#56708f;font-size:22rpx}.result-line{margin-top:10rpx;color:#24304a;font-size:34rpx;font-weight:750;line-height:1.45}.result-note{margin-top:14rpx;color:#617187;font-size:24rpx;line-height:1.5}.calc-hint{margin-top:22rpx;padding:20rpx;border-radius:18rpx;background:#fff8e8;color:#8a6419;font-size:23rpx;line-height:1.55}.disclaimer{margin-top:22rpx;text-align:center;color:#98a1af;font-size:21rpx}
