.postage-card{padding:28rpx}.postage-head{display:flex;align-items:flex-start;justify-content:space-between;padding-bottom:12rpx}.postage-title{display:block;font-size:32rpx;font-weight:750}.postage-subtitle{display:block;margin-top:7rpx;color:#8490a2;font-size:22rpx}.version{padding:8rpx 14rpx;border-radius:99rpx;background:#edf4ff;color:#1769ff;font-size:19rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #edf0f5}.label{display:block;margin-bottom:11rpx;color:#677386;font-size:23rpx}.input{width:100%;height:54rpx;font-size:28rpx}.picker-value{display:flex;justify-content:space-between;gap:18rpx;font-size:28rpx}.placeholder{color:#9aa4b3}.dimension-title{margin-top:24rpx;color:#677386;font-size:23rpx}.dimension-row{display:flex;gap:14rpx;margin-top:14rpx;padding-bottom:24rpx;border-bottom:1rpx solid #edf0f5}.dimension-input{width:0;flex:1;height:68rpx;padding:0 18rpx;border-radius:16rpx;background:#f6f8fc;text-align:center;font-size:26rpx}.specials{margin-top:18rpx;padding:4rpx 20rpx;border-radius:20rpx;background:#f7f9fc}.switch-row{display:flex;align-items:center;justify-content:space-between;min-height:82rpx;border-bottom:1rpx solid #e9edf3;font-size:26rpx}.switch-row:last-child{border-bottom:0}.switch-row switch{transform:scale(.82)}.insured-input{padding:18rpx 0 22rpx}.result-card{display:flex;flex-direction:column;margin-top:24rpx;padding:26rpx;border-radius:22rpx;background:linear-gradient(135deg,#edf4ff,#f8fbff)}.result-label{color:#56708f;font-size:22rpx}.result-price{margin:8rpx 0 12rpx;color:#1769ff;font-size:48rpx;font-weight:800}.result-detail{margin-top:5rpx;color:#617187;font-size:22rpx;line-height:1.55}.calc-hint{margin-top:22rpx;padding:20rpx;border-radius:18rpx;background:#fff8e8;color:#8a6419;font-size:23rpx;line-height:1.55}.disclaimer{margin-top:22rpx;text-align:center;color:#98a1af;font-size:21rpx}.compact{margin-top:24rpx;box-shadow:none}.compact .postage-head{padding-bottom:6rpx}